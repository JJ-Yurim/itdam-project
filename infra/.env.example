# Copy this file to .env before running Docker Compose.
# These values are for local development only.

POSTGRES_DB=mvp_backend
POSTGRES_USER=mvp_backend
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me-local-redis
REDIS_PORT=6379

RABBITMQ_USER=mvp_backend
RABBITMQ_PASSWORD=change-me-local-rabbitmq
RABBITMQ_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

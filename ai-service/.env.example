APP_NAME=mvp-ai-service
APP_ENV=local
LLM_PROVIDER=gemini-gms
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_CONNECT_TIMEOUT_SECONDS=2
LLM_READ_TIMEOUT_SECONDS=12
LLM_WRITE_TIMEOUT_SECONDS=5
LLM_POOL_TIMEOUT_SECONDS=2
LLM_REQUEST_BUDGET_SECONDS=25
LLM_MAX_CONCURRENCY=5
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY_SECONDS=0.25
LLM_RETRY_MAX_DELAY_SECONDS=2
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
PROMPT_VERSION=prompt-v1
RUBRIC_VERSION=rubric-v1
# 공동 책 생성. 문장 하나를 보는 평가와 달리 제출 문장 수십 개를 한 번에 엮으므로 지연과 출력이
# 훨씬 크다. 아래 값은 문장 30~60개 기준 실측(15~51초, 60문장에서 총 6,393토큰)에 맞춘 것이다.
# BOOK_LLM_MODEL을 비워두면 LLM_MODEL을 그대로 쓴다.
# 운영(Jenkinsfile.ai-service)과 동일한 모델. 실규모 검증을 통과한 조합은 프롬프트 v2 +
# gemini-2.5-pro + 온도 0.7이므로, 계약 위반을 재현·실험할 때도 같은 값을 쓴다.
BOOK_LLM_MODEL=gemini-2.5-pro
# 0.9는 body/contents 일치 같은 형식 계약을 확률적으로 깨는 경향이 있어 0.7을 기본으로 쓴다.
BOOK_LLM_TEMPERATURE=0.7
# 계약 위반 재시도(2차 시도)의 온도. 형식 준수 우선이라 본 시도보다 낮다.
BOOK_LLM_RETRY_TEMPERATURE=0.4
BOOK_MAX_OUTPUT_TOKENS=32768
BOOK_READ_TIMEOUT_SECONDS=180
# 세마포어 획득 후 실제 호출·재시도에 쓰는 총 예산(180초 시도 2회 + 백오프 여유).
BOOK_REQUEST_BUDGET_SECONDS=400
BOOK_MAX_CONCURRENCY=2
BOOK_PROMPT_VERSION=book-prompt-v2
# 생성 결과 안전성 재검수(정책 §12.4)에 쓰는 규칙 기반 필터.
SAFETY_FILTER_ENABLED=true
# 문장 임베딩(보스 제출 유사도 검사용). 비워두면 평가는 동작하되 임베딩이 응답에 포함되지 않는다.
# EMBEDDING_DIMENSIONS는 sentence_embeddings의 vector(N)와 반드시 같아야 한다.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768
# 평가 5건과 후속 임베딩 3건이 겹칠 수 있어 문장용 HTTP 연결 풀은 기본 8개가 된다.
EMBEDDING_MAX_CONCURRENCY=3
# 평가 budget(25s)과 합쳐 Backend read timeout(30s) 안에 들어야 한다.
EMBEDDING_REQUEST_BUDGET_SECONDS=3

BOOK_MQ_ENABLED=false
# 문장 평가 MQ 소비자(S15P11C206-208). backend의 evaluation.dispatch=rabbit과 함께 켠다.
# 평가 재료는 메시지에 실려 오므로 책과 달리 BOOK_DB_* 계정 없이 RABBITMQ_*만 있으면 된다.
EVALUATION_MQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=mvp_backend
RABBITMQ_PASSWORD=change-me-local-rabbitmq
RABBITMQ_VHOST=/
# 책 생성 재료를 읽는 SELECT 전용 Backend DB 계정 (S15P11C206-122).
BOOK_DB_HOST=localhost
BOOK_DB_PORT=5432
BOOK_DB_NAME=mvp_backend
BOOK_DB_USER=mvp_ai_readonly
BOOK_DB_PASSWORD=change-me-local-readonly
LOG_LEVEL=INFO

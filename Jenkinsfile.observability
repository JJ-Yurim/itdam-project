pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate') {
            steps {
                sh 'bash scripts/test-observability-config.sh'
                sh 'bash scripts/test-observability-runtime-env.sh'
                sh 'bash scripts/test-observability-secret-guard.sh'
                sh 'bash scripts/test-deploy-observability.sh'
                sh 'bash scripts/test-publish-deploy-event.sh'
            }
        }

        stage('Build deployment event publisher') {
            steps {
                sh 'docker build --progress=plain --target test -t c206-event-publisher-test infra/observability/event-publisher'
                sh 'docker run --rm c206-event-publisher-test'
                sh 'docker build --progress=plain --target production -t c206-deploy-event-publisher:local infra/observability/event-publisher'
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'develop-grafana-admin',
                    usernameVariable: 'JENKINS_GRAFANA_ADMIN_USER',
                    passwordVariable: 'JENKINS_GRAFANA_ADMIN_PASSWORD'
                )]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        set +x
                        umask 077
                        runtime_env=$(mktemp)
                        trap 'rm -f "$runtime_env"' EXIT

                        export GRAFANA_ADMIN_USER="$JENKINS_GRAFANA_ADMIN_USER"
                        export GRAFANA_ADMIN_PASSWORD="$JENKINS_GRAFANA_ADMIN_PASSWORD"
                        bash scripts/write-observability-runtime-env.sh "$runtime_env"

                        # 설정 파일 bind mount의 원본이 될 호스트 경로다. Jenkins는
                        # 컨테이너지만 Docker 데몬은 호스트 것이라, 워크스페이스 경로를
                        # 그대로 마운트하면 호스트에 없는 경로가 되어 Docker가 빈
                        # 디렉터리를 만든다. 배포 스크립트가 이 경로로 설정을 복사한다.
                        export OBSERVABILITY_CONFIG_DIR=/opt/c206-observability
                        bash scripts/deploy-observability.sh "$runtime_env"
                    '''
                }
            }
        }

        stage('Smoke') {
            steps {
                // smoke-observability.sh는 docker compose를 호출하므로 Deploy와 같은
                // env 파일이 필요하다. Deploy 스테이지가 만든 파일은 그 셸이 끝날 때
                // trap으로 지워지고, 스크립트 기본 경로인 infra/observability/.env는
                // gitignore 대상이라 Jenkins 워크스페이스에 존재하지 않는다. 전달하지
                // 않으면 이 스테이지는 "env file is not readable"로 매번 실패한다.
                // Deploy와 같은 방식으로 다시 만들어 OBSERVABILITY_ENV_FILE로 넘긴다.
                withCredentials([usernamePassword(
                    credentialsId: 'develop-grafana-admin',
                    usernameVariable: 'JENKINS_GRAFANA_ADMIN_USER',
                    passwordVariable: 'JENKINS_GRAFANA_ADMIN_PASSWORD'
                )]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        set +x
                        umask 077
                        runtime_env=$(mktemp)
                        trap 'rm -f "$runtime_env"' EXIT

                        export GRAFANA_ADMIN_USER="$JENKINS_GRAFANA_ADMIN_USER"
                        export GRAFANA_ADMIN_PASSWORD="$JENKINS_GRAFANA_ADMIN_PASSWORD"
                        bash scripts/write-observability-runtime-env.sh "$runtime_env"

                        SMOKE_REPORT_FILE=observability-smoke-report.txt \
                        OBSERVABILITY_ENV_FILE="$runtime_env" \
                          bash scripts/smoke-observability.sh
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'observability-smoke-report.txt', allowEmptyArchive: true
        }
        cleanup {
            deleteDir()
        }
    }
}
